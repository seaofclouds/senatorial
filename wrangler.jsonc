// Deploys Senatorial on Cloudflare Workers (no build step): this folder as static assets, plus worker.js for
// shared pages, which are kept in the senatorial-shares D1 database.
{
  "name": "senatorial",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "senatorial-shares",
      "database_id": "3f7827b6-b124-4288-a800-2db3d8334d6e",
      "migrations_dir": "migrations"
    }
  ],
  // Previews of other branches (npx wrangler preview) save shared pages to the same database as production
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "senatorial-shares",
        "database_id": "3f7827b6-b124-4288-a800-2db3d8334d6e"
      }
    ]
  }
}
